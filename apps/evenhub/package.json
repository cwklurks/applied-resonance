{
  "name": "evenhub-earsight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "package:validate": "npm run manifest:generate && npm run build && node scripts/validate-package.mjs",
    "pack": "npm run package:validate && evenhub pack app.generated.json ./dist -o applied-resonance.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "vitest run"
  },
  "dependencies": {
    "@earsight/display-card": "file:../../shared/display-card",
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
